 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Financial GenAI Chatbot - RAG Prototyping\n",
    "\n",
    "This notebook demonstrates how to build a Retrieval-Augmented Generation (RAG) QA Chain using Langchain's latest syntax, HuggingFace Embeddings, and the Groq API (as well as Zephyr locally via pipeline).\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "!pip install -q langchain langchain-groq langchain-huggingface chromadb sentence-transformers pandas\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import os\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# Set API Keys\n",
    "os.environ['GROQ_API_KEY'] = 'YOUR_GROQ_API_KEY'  # Replace with your actual Groq API Key\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Load Data\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "bank = pd.read_csv('BankFAQs.csv')\n",
    "bank['content'] = bank.apply(lambda row: f\"Question: {row['Question']}\\nAnswer: {row['Answer']}\", axis=1)\n",
    "bank.head()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from langchain.docstore.document import Document\n",
    "\n",
    "# Prepare documents for LangChain\n",
    "documents = []\n",
    "for _, row in bank.iterrows():\n",
    "    documents.append(Document(page_content=row['content'], metadata={'class': row.get('Class', 'unknown')}))\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Generate Embeddings & Load into ChromaDB\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from langchain_huggingface import HuggingFaceEmbeddings\n",
    "from langchain_community.vectorstores import Chroma\n",
    "\n",
    "# Using local HuggingFace embeddings\n",
    "hg_embeddings = HuggingFaceEmbeddings(model_name=\"all-MiniLM-L6-v2\")\n",
    "\n",
    "persist_directory = './chroma_db/'\n",
    "langchain_chroma = Chroma.from_documents(\n",
    "    documents=documents,\n",
    "    collection_name=\"chatbot_finance\",\n",
    "    embedding=hg_embeddings,\n",
    "    persist_directory=persist_directory\n",
    ")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Initialize LLM (Groq)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from langchain_groq import ChatGroq\n",
    "\n",
    "# Using Mixtral via Groq (Fastest and free tier open-source inference)\n",
    "llm = ChatGroq(temperature=0, model_name=\"mixtral-8x7b-32768\")\n",
    "\n",
    "# --- OPTIONAL: HUGGINGFACE LOCAL ZEPHYR PIPELINE --- \n",
    "# Uncomment the below code to use Zephyr locally. Note: Requires significant VRAM/RAM.\n",
    "# from langchain_huggingface import HuggingFacePipeline\n",
    "# from transformers import AutoTokenizer, AutoModelForCausalLM, pipeline\n",
    "# import torch\n",
    "# model_id = 'HuggingFaceH4/zephyr-7b-beta'\n",
    "# tokenizer = AutoTokenizer.from_pretrained(model_id)\n",
    "# model = AutoModelForCausalLM.from_pretrained(model_id, load_in_4bit=True, device_map='auto')\n",
    "# query_pipeline = pipeline(\"text-generation\", model=model, tokenizer=tokenizer, max_new_tokens=512)\n",
    "# llm = HuggingFacePipeline(pipeline=query_pipeline)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Build RAG Chain\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from langchain.prompts import PromptTemplate\n",
    "from langchain.chains import create_retrieval_chain\n",
    "from langchain.chains.combine_documents import create_stuff_documents_chain\n",
    "\n",
    "template = \"\"\"\n",
    "You are a Finance QNA Expert. Analyze the Query and Respond to Customer with a suitable answer.\n",
    "If you don't know the answer based on the context provided, just say \"Sorry, I don't know.\"\n",
    "\n",
    "Context: {context}\n",
    "Question: {input}\n",
    "Answer: \"\"\"\n",
    "\n",
    "PROMPT = PromptTemplate.from_template(template)\n",
    "\n",
    "retriever = langchain_chroma.as_retriever(search_kwargs={\"k\": 3})\n",
    "\n",
    "document_chain = create_stuff_documents_chain(llm, PROMPT)\n",
    "qa_chain = create_retrieval_chain(retriever, document_chain)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def chat_with_rag():\n",
    "    print(\"Welcome to the GenAI Financial Chatbot. Type 'exit' to end the conversation.\")\n",
    "    while True:\n",
    "        query = input(\"You: \")\n",
    "        if query.lower() in [\"exit\", \"quit\"]:\n",
    "            break\n",
    "        try:\n",
    "            result = qa_chain.invoke({\"input\": query})\n",
    "            print(f\"Chatbot: {result['answer']}\\n\")\n",
    "        except Exception as e:\n",
    "            print(f\"Error encountered: {e}\")\n",
    "\n",
    "# Run the chat in the notebook\n",
    "# chat_with_rag()\n"
   ]
  }
 ],
